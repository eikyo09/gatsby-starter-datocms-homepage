# Create a .env.development and a .env.production file
# with the following keys.
# Do NOT check these files into source control
DATOCMS_API_TOKEN=""
DATOCMS_ENVIRONMENT=""

# Toggl earnings widget (/earnings page and `yarn earnings`)
# API token: Toggl Track -> Profile settings -> API Token
TOGGL_API_TOKEN=
# Your default hourly rate, used for every project without its own rate
TOGGL_HOURLY_RATE=70
# ISO currency code used for formatting
TOGGL_CURRENCY=USD
# Optional: per-project rates keyed by Toggl project name or id.
# Use "(no project)" for entries without a project.
# TOGGL_PROJECT_RATES={"Client A": 80, "12345": 60, "(no project)": 0}
# Optional: only count entries flagged billable in Toggl
# TOGGL_BILLABLE_ONLY=false
# Optional: override the time zone used for month boundaries (defaults to your Toggl profile time zone)
# TOGGL_TIMEZONE=Europe/Berlin
